          <span class="text-[10px] font-bold text-brand-neonPink bg-brand-neonPink/10 px-2 py-0.5 rounded uppercase">賽事當天</span>
          <strong class="text-white text-sm block">補給能量與防抽筋</strong>
          <p class="text-slate-400 text-xs leading-relaxed">
            務必隨身攜帶高能量補給品（如能量果凍、香蕉、巧克力或能量棒），供預賽與複賽間隙回補體力。
          </p>
          <p class="text-brand-neonBlue text-[11px] font-bold">
            💡 運動飲料或水必備！建議以 1:1 的比例加水稀釋運動飲料，可防賽場高強度抽筋。
          </p>
        </div>
      </div>
    </section>

    <!-- SLIDE 16: 複賽晉級與落幕頒獎 -->
    <section id="slide-16" class="slide-content slide-enter hidden flex flex-col justify-center items-center text-center space-y-6 py-8">
      <div class="w-16 h-16 bg-brand-neonPink/10 rounded-full flex items-center justify-center border border-brand-neonPink/30 shadow-neon-pink">
        <span class="text-3xl text-brand-neonPink">🏆</span>
      </div>
      <h2 class="text-3xl font-extrabold text-white">複賽晉級與落幕頒獎</h2>
      <div class="max-w-md bg-brand-card/60 p-5 rounded-2xl border border-slate-800 space-y-3 text-sm text-slate-300">
        <p><strong class="text-white">晋級條件：</strong> 各小組取其積分前 <span class="text-brand-neonBlue font-bold text-base">二名</span> 晉級下輪複賽。</p>
        <p><strong class="text-white">受獎隊伍：</strong> 比賽取前四名頒發豐厚大會獎勵。</p>
        <p><strong class="text-white">頒獎時間：</strong> 將於兩日賽程全部結束後，現場由主辦單位頒發榮譽證書與獎盃。</p>
      </div>
      <p class="text-slate-400 text-xs italic pt-4">
        勝不驕、敗不餒，祝所有大船與 A-FORCE 球友發揮水準、賽出風采！
      </p>
      <button onclick="goToSlide(1)" class="text-xs text-brand-neonBlue hover:underline flex items-center space-x-1 pt-2">
        <span>🔄 返回簡報首頁</span>
      </button>
    </section>

  </main>

  <!-- 底部常駐控制導航列 (完美手機版優化) -->
  <footer class="w-full bg-brand-card/90 backdrop-blur-md border-t border-slate-800 py-4 px-6 flex flex-col space-y-3 md:space-y-0 md:flex-row md:justify-between md:items-center sticky bottom-0 z-50">
    <!-- 桌機與平板版的 Slide 指示點點 (手機上隱藏，改用進度條) -->
    <div class="hidden md:flex space-x-1.5" id="desktop-dots">
      <!-- 點點由 JavaScript 動態生成 -->
    </div>

    <!-- 手機版進度條與頁碼 badge (桌機上隱藏) -->
    <div class="flex items-center justify-between w-full md:hidden">
      <span class="text-[10px] text-brand-textGray uppercase font-bold tracking-wider">頁面進度</span>
      <div class="w-2/3 bg-slate-800 h-1.5 rounded-full overflow-hidden">
        <div id="mobile-progress-bar" class="bg-brand-neonBlue h-full rounded-full transition-all duration-300" style="width: 6.25%;"></div>
      </div>
      <span id="mobile-page-indicator" class="text-xs bg-slate-800 px-2 py-0.5 rounded font-bold text-slate-200">1/16</span>
    </div>

    <!-- 控制按鈕列 -->
    <div class="flex justify-between items-center w-full md:w-auto md:space-x-4">
      <button onclick="prevSlide()" class="bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl border border-slate-700 transition active:scale-95 flex items-center space-x-1 h-10 w-24 justify-center">
        <span>◀ 上一頁</span>
      </button>
      
      <button onclick="goToSlide(3)" class="bg-slate-800/40 hover:bg-slate-800 text-brand-neonBlue font-bold text-xs px-3 py-2.5 rounded-xl border border-brand-neonBlue/20 transition active:scale-95 flex items-center space-x-1 h-10 w-24 justify-center">
        <span>📋 目錄</span>
      </button>
      
      <button onclick="nextSlide()" class="bg-brand-neonBlue text-brand-dark font-extrabold text-xs px-4 py-2.5 rounded-xl transition shadow-neon-blue active:scale-95 flex items-center space-x-1 h-10 w-24 justify-center">
        <span>下一頁 ▶</span>
      </button>
    </div>
  </footer>

  <!-- JavaScript 幻燈片控制核心 -->
  <script>
    const TOTAL_SLIDES = 16;
    let currentSlide = 1;

    // 手指滑動翻頁相關變數
    let touchStartX = 0;
    let touchEndX = 0;
    let touchStartY = 0;
    let touchEndY = 0;

    // 初始化點點
    const desktopDotsContainer = document.getElementById('desktop-dots');
    for (let i = 1; i <= TOTAL_SLIDES; i++) {
      const dot = document.createElement('button');
      dot.className = `w-2 h-2 rounded-full transition-all duration-300 ${i === 1 ? 'bg-brand-neonBlue w-4 shadow-neon-blue' : 'bg-slate-700 hover:bg-slate-600'}`;
      dot.onclick = () => goToSlide(i);
      dot.id = `dot-${i}`;
      desktopDotsContainer.appendChild(dot);
    }

    // 智能判斷：是否在可水平滑動的表格或地圖上 (防手勢衝突)
    function isWithinScrollable(element) {
      if (!element || element === document.body) return false;
      if (element.classList && (element.classList.contains('scroll-container') || element.classList.contains('overflow-x-auto') || element.tagName === 'svg')) {
        return true;
      }
      return isWithinScrollable(element.parentElement);
    }

    // 跳轉頁面函式
    function goToSlide(slideNum) {
      if (slideNum < 1 || slideNum > TOTAL_SLIDES) return;
      
      // 隱藏當前頁面
      document.getElementById(`slide-${currentSlide}`).classList.add('hidden');
      
      // 顯示新頁面
      const nextSlideEl = document.getElementById(`slide-${slideNum}`);
      nextSlideEl.classList.remove('hidden');
      
      // 滾動到主容器頂部 (手機板極其重要)
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // 更新進度與UI樣式
      document.getElementById(`dot-${currentSlide}`).className = "w-2 h-2 rounded-full bg-slate-700 hover:bg-slate-600 transition-all duration-300";
      document.getElementById(`dot-${slideNum}`).className = "w-2 h-2 rounded-full bg-brand-neonBlue w-4 shadow-neon-blue transition-all duration-300";
      
      currentSlide = slideNum;

      // 更新頂部 Badge 頁碼
      document.getElementById('slide-badge').innerText = `${currentSlide.toString().padStart(2, '0')} / ${TOTAL_SLIDES.toString().padStart(2, '0')}`;
      
      // 更新手機版指示器
      document.getElementById('mobile-page-indicator').innerText = `${currentSlide}/${TOTAL_SLIDES}`;
      document.getElementById('mobile-progress-bar').style.width = `${(currentSlide / TOTAL_SLIDES) * 100}%`;
    }

    function nextSlide() {
      if (currentSlide < TOTAL_SLIDES) {
        goToSlide(currentSlide + 1);
      } else {
        // 循環回首頁
        goToSlide(1);
      }
    }

    function prevSlide() {
      if (currentSlide > 1) {
        goToSlide(currentSlide - 1);
      }
    }

    // 3F 戰術地圖雙日圖層切換
    function switchMapDay(day) {
      const satLayer = document.getElementById('layer-map-sat');
      const sunLayer = document.getElementById('layer-map-sun');
      const btnSat = document.getElementById('btn-map-sat');
      const btnSun = document.getElementById('btn-map-sun');

      if (day === 'sat') {
        satLayer.classList.remove('opacity-0', 'pointer-events-none');
        sunLayer.classList.add('opacity-0', 'pointer-events-none');
        
        btnSat.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-brand-neonBlue text-brand-dark shadow-neon-blue";
        btnSun.className = "px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all";
      } else {
        sunLayer.classList.remove('opacity-0', 'pointer-events-none');
        satLayer.classList.add('opacity-0', 'pointer-events-none');
        
        btnSun.className = "px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-brand-neonPink text-white shadow-neon-pink";
        btnSat.className = "px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all";
      }
    }

    // 手動觸發按鈕鍵盤控制
    document.addEventListener('keydown', function(event) {
      if (event.key === 'ArrowRight' || event.key === ' ') {
        nextSlide();
      } else if (event.key === 'ArrowLeft') {
        prevSlide();
      }
    });

    // 手勢觸摸滑動事件處理 (含表格/地圖手勢防衝突)
    document.addEventListener('touchstart', function(event) {
      touchStartX = event.changedTouches[0].screenX;
      touchStartY = event.changedTouches[0].screenY;
    }, false);

    document.addEventListener('touchend', function(event) {
      touchEndX = event.changedTouches[0].screenX;
      touchEndY = event.changedTouches[0].screenY;
      
      // 如果觸碰的是地圖、SVG、或可水平滑動的表格，自動阻斷簡報切頁手勢
      if (isWithinScrollable(event.target)) {
        return; 
      }

      handleSwipeGesture();
    }, false);

    function handleSwipeGesture() {
      const swipeDistanceX = touchStartX - touchEndX;
      const swipeDistanceY = touchStartY - touchEndY;
      
      // 確保橫向滑動距離明顯大於縱向，且滿足至少 50px 閥值
      if (Math.abs(swipeDistanceX) > Math.abs(swipeDistanceY) && Math.abs(swipeDistanceX) > 50) {
        if (swipeDistanceX > 0) {
          nextSlide(); // 向左滑動 -> 下一頁
        } else {
          prevSlide(); // 向右滑動 -> 上一頁
        }
      }
    }

    // 頁面加載完成時，預設顯示第一頁
    window.onload = function() {
      goToSlide(1);
    }
  </script>
</body>
</html>
